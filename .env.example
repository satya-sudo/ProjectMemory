# Automatically loaded from the working directory; existing environment wins.
PROJECTMAP_ADDR=127.0.0.1:8080
PROJECTMAP_CREDENTIALS_FILE=.local/credentials.json
# Keep this URL's password consistent with PROJECTMAP_POSTGRES_PASSWORD.
PROJECTMAP_POSTGRES_PASSWORD=projectmap_local
PROJECTMAP_DATABASE_URL=postgres://projectmap:projectmap_local@127.0.0.1:15432/projectmap?sslmode=disable
# Optional test database override. Otherwise `make test-db` uses the URL above.
# PROJECTMAP_TEST_DATABASE_URL=postgres://projectmap:projectmap_local@127.0.0.1:15432/projectmap?sslmode=disable
